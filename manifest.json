{
  "manifest_version": 3,
  "name": "Truyện Nói - Đọc Truyện Tự Động",
  "version": "1.1.0",
  "description": "Đọc nội dung truyện web tự động bằng TTS. Hỗ trợ Web Speech API & Microsoft Edge TTS",
  "permissions": [
    "scripting",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "src/ui/popup.html",
    "default_title": "Truyện Nói - TTS Reader"
  },
  "background": {
    "service_worker": "src/background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "src/logger/logger.js",
        "src/core/state-manager.js",
        "src/core/tts-engine.js",
        "src/core/content-extractor.js",
        "src/core/chapter-navigator.js",
        "src/core/highlight-manager.js",
        "src/core/content-v2.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/logger/debug.html", "src/logger/debug.js"],
      "matches": ["<all_urls>"]
    }
  ]
}

